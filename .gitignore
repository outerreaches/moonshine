# Linked tools, as a pattern rather than a list, for the same reason as the gate
# binaries below: the list omitted /tools/mimo26_gpu_eval, so a 1.15 MB ROCm
# binary was committed in a1de695 and went unnoticed. Every tool here builds
# from a same-named source, so the negations are exhaustive.
/tools/mimo26_*
!/tools/mimo26_*.c
!/tools/mimo26_*.cu
!/tools/mimo26_*.h
!/tools/mimo26_*.py
mimo26-eval.jsonl
mimo26-eval-tokens.txt
/tools/transcode_mzg2_layer

# Phase-4 goldens derived from official GLM-5.3-Flash weights. Provenance and
# digests are committed; the bytes are regenerated locally. See
# docs/glm53-phase4-goldens.md.
/tests/fixtures/glm53_phase4_components.bin
/tests/fixtures/glm53_phase4_kda_v1.bin
/tests/fixtures/glm53_official_projection_f32.bin
tests/test_k3_*
!tests/test_k3_*.c
!tests/test_k3_*.cu
tests/test_glm53_*
!tests/test_glm53_*.c
!tests/test_glm53_*.cu
tests/test_mimo26_*
!tests/test_mimo26_*.c
!tests/test_mimo26_*.cu
!tests/test_mimo26_*.py
!tests/test_mimo26_rans_screen.cpp
__pycache__/
*.pyc
.venv-sdk/
moonshine-pre-public-history-*.bundle
.DS_Store
.*.swp
# Built gate binaries. A pattern, not a list: naming them one at a time meant
# every new gate was untracked-dirty until someone noticed, and three of them
# were committed as binaries before this. Sources keep their extension, so
# only the linked output matches.
tests/mimo26_*_gate
!tests/mimo26_*_gate.c
!tests/mimo26_*_gate.cu
!tests/mimo26_*_gate.py

# Diagnostic harnesses that are not gates and so miss the pattern above. Same
# rule: the linked output is ignored, the source keeps its extension.
tests/mimo26_mxfp4_oracle_sweep
tests/replay_mimo26_projection
